<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="booktown-backend"/>

    <appender name="CONSOLE_PATTERN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] trace_id=%X{trace_id:-} %logger{36} - %replace(%msg){'(?i)(password|token|secret|api_key|authorization|cookie)=\S+','$1=****'}%n%ex</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="com.booktown.global.logging.StructuredJsonLogLayout"/>
    </appender>

    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        <logger name="com.booktown" level="INFO"/>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_PATTERN"/>
        </root>
    </springProfile>
</configuration>
